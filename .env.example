SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

SPOTIFY_CLIENT_ID=YOUR_SPOTIFY_CLIENT_ID
SPOTIFY_CLIENT_SECRET=YOUR_SPOTIFY_CLIENT_SECRET
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/callback

# Users supply their own session-only API key in the app; no fallback shared key.
ANTHROPIC_MODEL=claude-sonnet-5

# Set production for deployment; all HTTP requests will be rejected.
# Terminate TLS at your reverse proxy and configure uvicorn --forwarded-allow-ips
# with ONLY your trusted proxy address (never "*").
ADAPTUNE_ENV=development
